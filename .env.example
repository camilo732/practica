# ---------------------------------------------------------------------------
# LibroLog · plantilla de variables de entorno
# Copiar a .env y cambiar los valores. El archivo .env NO se sube a Git.
# ---------------------------------------------------------------------------

# PostgreSQL local (pgAdmin)
POSTGRES_DB=librolog_app
DB_USERNAME=postgres
DB_PASSWORD=cambia_esta_clave
DB_URL=jdbc:postgresql://localhost:5432/librolog_app

# PostgreSQL alternativo en Docker (solo si se usa docker-compose)
DB_PORT=5433

# JWT: mínimo 64 caracteres aleatorios
JWT_SECRET=cambia_esta_clave_por_una_aleatoria_de_64_caracteres
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Aplicación
APP_FRONTEND_URL=http://localhost:8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5500
APP_REQUIRE_HTTPS=false

# Seguridad de la autenticación (Fase 2)
APP_AUTH_RATE_LIMIT=20
APP_MAX_FAILED_ATTEMPTS=5
APP_LOCK_MINUTES=15

# Administración (Fase 7): correos que reciben el rol ADMIN al arrancar.
# Debe ser una cuenta ya registrada. Varios correos separados por coma.
APP_ADMIN_EMAILS=

# HTTPS local del perfil "dev" (ver docs/https-local.md)
APP_SSL_PASSWORD=changeit
# HSTS: true en producción; el perfil dev lo desactiva para no fijar localhost.
APP_HSTS_ENABLED=true

# Catálogo externo (Fase 3)
OPENLIBRARY_BASE_URL=https://openlibrary.org
OPENLIBRARY_USER_AGENT=LibroLog/1.0 (academico; contacto: correo@ejemplo.com)
OPENLIBRARY_CONNECT_TIMEOUT_MS=3000
OPENLIBRARY_READ_TIMEOUT_MS=5000

# Google OAuth2 (Fase 7)
# Authorized redirect URIs en Google Cloud (añadir las dos si se usa el perfil dev):
#   http://localhost:8080/login/oauth2/code/google
#   https://localhost:8443/login/oauth2/code/google
# Si se dejan vacías, la aplicación arranca y oculta el botón de Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
